  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "const authRequest = {\r",
          "    // montagem do request de autenticação\r",
          "    url: pm.environment.get(\"base_url\") + '/auth', \r",
          "    method: 'POST',\r",
          "    header: {\r",
          "        'Content-Type': 'application/json'\r",
          "    },\r",
          "    body: {\r",
          "        mode: 'raw',\r",
          "        raw: JSON.stringify({\r",
          "            \"username\": \"admin\",\r",
          "            \"password\": \"password123\"\r",
          "        })\r",
          "    }\r",
          "};\r",
          "\r",
          "pm.sendRequest(authRequest, function (err, res) {\r",
          "    if (err) {\r",
          "        console.log(\"Error fetching token: \", err);\r",
          "    } else {\r",
          "        // Formata a resposta para extrair a variavel token\r",
          "        let responseJson = res.json();\r",
          "        \r",
          "        // Salva o token na variavel token\r",
          "        if (responseJson.token) {\r",
          "            pm.environment.set(\"token\", responseJson.token);\r",
          "            console.log(\"New token generated and saved to environment!\");\r",
          "        }\r",
          "    }\r",
          "});"
        ]
      }
    },
